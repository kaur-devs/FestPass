{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "^generate", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.test.tsx"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^generate", "generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint", "^generate", "generate"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^generate", "generate"]
    },
    "test": {
      "dependsOn": ["^generate", "generate"],
      "env": ["TEST_DATABASE_SERVER_URL"],
      "outputs": []
    }
  }
}
