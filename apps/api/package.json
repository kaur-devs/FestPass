{
  "name": "@festpass/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run \"/^dev:/\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "tsdown",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/server.mjs",
    "start:worker": "node --enable-source-maps --env-file-if-exists=.env dist/worker.mjs",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@festpass/db": "workspace:*",
    "@festpass/shared": "workspace:*",
    "@fontsource/big-shoulders": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "arctic": "^3.7.0",
    "bullmq": "^6.4.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@festpass/config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsdown": "^0.23.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^5.0.5"
  }
}
